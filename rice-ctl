def touchpads():
    try:
        import dbus
        m = dbus.Interface(bus().get_object("org.kde.KWin", "/org/kde/KWin/InputDevice"), "org.freedesktop.DBus.Properties")
        out = []
        for d in m.Get("org.kde.KWin.InputDeviceManager", "devicesSysNames"):
            p = dbus.Interface(bus().get_object("org.kde.KWin", "/org/kde/KWin/InputDevice/" + d), "org.freedesktop.DBus.Properties")
            if p.Get("org.kde.KWin.InputDevice", "touchpad"):
                out.append(p)
        return out
    except Exception:
        return []


