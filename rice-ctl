def reload_cfg(f):
    """Make running Plasma pick up a config change (on top of kwriteconfig6 --notify)."""
    if f == "kwinrc":
        dcall("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")
    elif f == "kscreenlockerrc":
        dcall("org.freedesktop.ScreenSaver", "/ScreenSaver", "org.kde.screensaver", "configure")
    elif f == "powerdevilrc":
        dcall("org.kde.Solid.PowerManagement", "/org/kde/Solid/PowerManagement", "org.kde.Solid.PowerManagement",
              "reparseConfiguration")
    elif f == "kxkbrc":
        sh(["dbus-send", "--session", "--type=signal", "/Layouts", "org.kde.keyboard.reloadConfig"])


