def notifyrc_action(app, event):
    """Effective Action of an event: your ~/.config override, else the app's default."""
    import configparser
    for path in (CFG / f"{app}.notifyrc", pathlib.Path(f"/usr/share/knotifications6/{app}.notifyrc")):
        c = configparser.ConfigParser(interpolation=None, strict=False)
        c.optionxform = str
        try:
            c.read(path, encoding="utf-8")
        except Exception:
            continue
        if c.has_option(f"Event/{event}", "Action"):
            return c.get(f"Event/{event}", "Action")
    return None                                   # event not installed


def notifyrc_default(app, event):
    import configparser
    c = configparser.ConfigParser(interpolation=None, strict=False)
    c.optionxform = str
    try:
        c.read(f"/usr/share/knotifications6/{app}.notifyrc", encoding="utf-8")
        return c.get(f"Event/{event}", "Action")
    except Exception:
        return None


def sound_group_state(fid):
    acts = [notifyrc_action(a, e) for a, e in SOUND_GROUPS[fid][2]]
    acts = [x for x in acts if x is not None]
    return bool(acts) and all("Sound" in x.split("|") for x in acts), len(acts)


def sound_group_set(fid, on):
    apps = set()
    for app, event in SOUND_GROUPS[fid][2]:
        cur = notifyrc_action(app, event)
        if cur is None:
            continue
        parts = [x for x in cur.split("|") if x and x != "Sound"]
        if on:
            parts.insert(0, "Sound")
        new = "|".join(parts)
        default = notifyrc_default(app, event)
        same = default is not None and set(new.split("|")) - {""} == set(default.split("|")) - {""}
        kwrite(f"{app}.notifyrc", f"Event/{event}", "Action", None if same else new)   # back to default = no override
        apps.add(app)
    for app in apps:
        f = CFG / f"{app}.notifyrc"
        if f.exists() and not f.read_text().strip():
            f.unlink()                                  # nothing overridden any more
    for app in apps:   # same signal System Settings sends, so running apps re-read the setting
        sh(["dbus-send", "--session", "--type=signal", "/Config", "org.kde.knotification.reparseConfiguration", f"string:{app}"])


