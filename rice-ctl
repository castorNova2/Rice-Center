# Sound section reads: master switch, volume pop, each kind of sound, then the extras
SOUND_ORDER = ["sys-sounds", "vol-feedback"] + list(SOUND_GROUPS) + ["notifysound", "vol-over100", "vol-step"]


def arrange(fs):
    """Keep each page's sections together (in order of first appearance) and order the Sound section."""
    out, seen = [], {}
    for f in fs:
        key = (f["page"], f.get("section", ""))
        if key not in seen:
            seen[key] = []
            out.append(seen[key])
        seen[key].append(f)
    for group in out:
        if group and group[0].get("section") == "Sound":
            group.sort(key=lambda f: SOUND_ORDER.index(f["id"]) if f["id"] in SOUND_ORDER else 99)
    return [f for g in out for f in g]


def feature(fid):
    return build(fid)[0]


# ------------------------------------------------------------------------------------------- changes
def turn(fid, on):
    f = feature(fid)
    if "units" in f and f["kind"] in ("toggle", "report"):
        units_set(f["units"], on)
        if fid == "screentime" and on:
            pass
        return
    if "plugin" in f:
        (effect_set if f["page"] == "look" else script_set)(f["plugin"], on)
        return
    if fid in SHORTCUTS:
        shortcut_set(fid, on)
        return
    if fid in CFG_FEATURES:
        cfg_set(fid, CFG_FEATURES[fid][4][0 if on else 1])
        return
    if fid in TOUCH:
        touch_set(fid, on)
        return
    if fid in SOUND_GROUPS:
        sound_group_set(fid, on)
        return
    if fid == "baloo":
        sh(["balooctl6", "enable" if on else "disable"], timeout=30, check=True)
        return
    if fid == "scheme":
        sh(["plasma-apply-colorscheme", "MidnightBlue" if on else "BreezeDark"], check=True)
    elif fid == "plasmastyle":
        sh(["plasma-apply-desktoptheme", "rice" if on else "default"], check=True)
    elif fid == "gtk":
        run_bin("rice-gtk", "on" if on else "off")
    elif fid == "hyprkeys":
        run_bin("rice-keys", "on" if on else "off")
    elif fid == "splash":
        kwrite("ksplashrc", "KSplash", "Theme", "org.rice.splash" if on else "org.kde.breeze.desktop")
    elif fid == "yakuake":
        a = CFG / "autostart/org.kde.yakuake.desktop"
        parked = KR / "disabled/org.kde.yakuake.desktop"
        if on:
            a.parent.mkdir(parents=True, exist_ok=True)
            src = parked if parked.exists() else pathlib.Path("/usr/share/applications/org.kde.yakuake.desktop")
            sh(["cp", "-a", str(src), str(a)], check=True)
        elif a.exists():
            parked.parent.mkdir(parents=True, exist_ok=True)
            a.replace(parked)
    elif fid == "topbar":
        if feature("topbar")["on"] != on:
            run_bin("toggle-topbar")
    elif fid == "focus":
        if on:
            s = OPTS
            run_bin("rice-focus", "on", str(s.get("work", 25)), str(s.get("break", 5)), str(s.get("rounds", 4)))
        else:
            run_bin("rice-focus", "off")
    elif fid == "awake":
        run_bin("rice-awake", "on", str(OPTS.get("hours", 1))) if on else run_bin("rice-awake", "off")
    elif fid == "standby":
        run_bin("rice-standby", "on" if on else "off")
        units_set(["rice-standby.service"], True) if on else None
    elif fid == "bravegpu":
        run_bin("rice-brave-gpu", *([] if on else ["undo"]))
    elif fid == "lite":
        if on:
            CACHE.mkdir(parents=True, exist_ok=True)
            LITE_FLAG.touch()
            for e in ("blur", "kwin4_effect_shapecorners", "rice-tide"):
                dcall("org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "unloadEffect", e)
        else:
            LITE_FLAG.unlink(missing_ok=True)
            for e in ("blur", "kwin4_effect_shapecorners", "rice-tide"):
                if kwin_enabled(e):
                    dcall("org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "loadEffect", e)
    else:
        raise RuntimeError(f"{fid} can't be turned on/off")


def set_value(fid, key, value):
    if fid == "look":
        return look_switch(value, layout=OPTS.get("layout") in ("1", "true"))
    if fid == "mood":
        return run_bin("rice-mood", value, timeout=60)[1]
    if fid in CFG_FEATURES:
        if not any(o[0] == value for o in CFG_FEATURES[fid][4]):
            raise RuntimeError(f"{value} is not an option")
        cfg_set(fid, value)
        return ""
    if fid == "capslock":
        if not any(c[0] == value for c in CAPS):
            raise RuntimeError("not an option")
        opts = [o for o in kread("kxkbrc", "Layout", "Options", "").split(",") if o and not o.startswith(("caps:", "ctrl:nocaps"))]
        if value:
            opts.append(value)
        if opts:
            kwrite("kxkbrc", "Layout", "Options", ",".join(opts))
            kwrite("kxkbrc", "Layout", "ResetOldOptions", True)
        else:                              # nothing left: back to no override at all
            kwrite("kxkbrc", "Layout", "Options", None)
            kwrite("kxkbrc", "Layout", "ResetOldOptions", None)
        reload_cfg("kxkbrc")
        return ""
    if fid == "sounds":
        kwrite("kdeglobals", "Sounds", "Theme", value)
        return ""
    if fid == "standby":
        if key == "lock":
            return run_bin("rice-standby", "set", "lock", "on" if value in ("1", "true", "on") else "off")[1]
        return run_bin("rice-standby", "set", key, value)[1]
    if fid == "screentime":
        return run_bin("rice-screentime", "set", key, value)[1]
    raise RuntimeError(f"{fid} has no setting {key}")


def action(fid, act, arg=None):
    if fid == "look" and act in ("rice", "stock", "original"):
        return look_switch(act, layout=OPTS.get("layout") in ("1", "true"))
    if fid == "doctor":
        rc, o = run_bin("rice-doctor", "-q", timeout=90)
        CACHE.mkdir(parents=True, exist_ok=True)
        DOCTOR_CACHE.write_text(f"{rc}\n{time.strftime('%H:%M')}\n{o}")
        return run_bin("rice-doctor", timeout=90)[1] if act == "full" else ""
    if fid == "quick":
        if act == "restart-plasma":
            restart_plasma(); return "Plasma restarted"
        if act == "usage":
            detach(["xdg-open", str(USAGE)]); return ""
        if act == "ideas":
            detach(["xdg-open", str(H / "Desktop/kde-rice-ideas.md")]); return ""
        if act == "folder":
            detach(["dolphin", str(RICE)]); return ""
        if act == "sync":
            rc, o = sh([str(H / "Documents/Code/kde-rice/scripts/export-from-live.sh")], timeout=300)
            return ("done" if rc == 0 else "FAILED") + "\n" + o
    if fid == "bravetheme":
        if act == "rebuild":
            return run_bin("rice-brave-theme")[1]
        if act == "folder":
            detach(["dolphin", run_bin("rice-brave-theme", "path")[1].strip()]); return ""
    if fid == "lockscreen" and act == "rebuild":
        return run_bin("rice-lockscreen", "--force")[1]
    if fid == "daynight" and act == "repick":
        return run_bin("daynight-wallpaper", "--force")[1]
    if fid == "standby" and act == "show":
        detach([str(BIN / "rice-standby"), "show"]); return ""
    if fid == "screentime":
        if act == "week":
            return run_bin("rice-screentime", "week")[1]
        if act == "forget":
            return run_bin("rice-screentime", "forget")[1]
    if fid == "perf" and act == "quick":
        return run_bin("rice-perf", "--quick", timeout=60)[1]
    if fid == "chargelimit":
        konsole(f"{shlex.quote(str(BIN / 'rice-charge-limit'))} {'on' if act == 'on' else 'off'}")
        return "opened Konsole (asks for your password)"
    if fid == "snapshots":
        if act == "create":
            name = re.sub(r"[^a-z0-9-]+", "-", (arg or "manual").lower()).strip("-")[:40] or "manual"
            return run_bin("rice-backup", name, timeout=120)[1]
        if act == "restore":
            if not arg or not re.match(r"^\d+-pre-[A-Za-z0-9_.-]+$", arg):
                raise RuntimeError("pick a snapshot")
            script = RICE / "backups" / arg / "restore-this-state.sh"
            if not script.exists():
                raise RuntimeError(f"{arg} has no restore script")
            sh(["systemctl", "--user", "stop", "plasma-plasmashell.service"], timeout=30)
            rc, o = sh(["bash", str(script)], timeout=180)
            sh(["systemctl", "--user", "start", "plasma-plasmashell.service"], timeout=30)
            dcall("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")
            return o
    raise RuntimeError(f"unknown action {fid}/{act}")


def help_text(fid):
    f = feature(fid)
    head = f.get("help") or ""
    if not head:
        return f"**{f['title']}**\n\n{f['desc']}"
    lines = USAGE.read_text().splitlines()
    level = len(head) - len(head.lstrip("#"))
    for i, l in enumerate(lines):
        if l.startswith(head):
            body = [l]
            for m in lines[i + 1:]:
                if re.match(r"^#{1,%d} " % level, m):
                    break
                body.append(m)
            return "\n".join(body).strip()
    return f"**{f['title']}**\n\n{f['desc']}"


# ------------------------------------------------------------------------------------------- CLI
OPTS = {}


def public(f):
    return {k: v for k, v in f.items() if k not in ("units", "plugin")}


def emit(obj):
    print(json.dumps(obj, ensure_ascii=False))


def main():
    a = sys.argv[1:]
    # --opt key=value pass-through (focus minutes, awake hours, ...)
    while "--opt" in a:
        i = a.index("--opt")
        k, _, v = a[i + 1].partition("=")
        OPTS[k] = v
        del a[i:i + 2]
    cmd = a[0] if a else "list"
    try:
        if cmd == "list":
            fs = build()
            if "--json" in a:
                emit([public(f) for f in fs])
            else:
                for f in fs:
                    st = {True: "on ", False: "off", None: "   "}[f.get("on")]
                    val = f" [{f['value']}]" if f.get("value") not in (None, "") else ""
                    print(f"{st} {f['page']:<12} {f['id']:<18} {f['title']}{val}")
        elif cmd == "get":
            emit(public(feature(a[1])))
        elif cmd in ("on", "off"):
            turn(a[1], cmd == "on")
            _units.clear()
            emit({"ok": True, "feature": public(feature(a[1]))})
        elif cmd == "set":
            fid, rest = a[1], a[2:]
            key, value = (rest[0], rest[1]) if len(rest) == 2 else ("value", rest[0])
            msg = set_value(fid, key, value)
            _units.clear()
            emit({"ok": True, "output": msg or "", "feature": public(feature(fid))})
        elif cmd == "action":
            msg = action(a[1], a[2], a[3] if len(a) > 3 else None)
            _units.clear()
            emit({"ok": True, "output": msg or "", "feature": public(feature(a[1]))})
        elif cmd == "help":
            print(help_text(a[1]))
        elif cmd == "look":
            print(look_switch(a[1], layout="--layout" in a))
        elif cmd in ("-h", "--help"):
            print("\n".join(l[2:] for l in open(__file__).read().splitlines()[1:12]))
        else:
            raise RuntimeError(f"unknown command {cmd}")
    except KeyError as e:
        emit({"ok": False, "error": f"unknown feature {e}"}); sys.exit(2)
    except Exception as e:
        emit({"ok": False, "error": str(e)}); sys.exit(1)


if __name__ == "__main__":
    main()
