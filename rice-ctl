# ------------------------------------------------------------------------------------------- helpers
def sh(cmd, timeout=20, check=False):
    """Run a command (list or shell string); return (rc, stdout+stderr)."""
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=timeout)
        out = (r.stdout + (("\n" + r.stderr) if r.stderr.strip() else "")).strip()
        if check and r.returncode != 0:
            raise RuntimeError(out or f"exit {r.returncode}")
        return r.returncode, out
    except subprocess.TimeoutExpired:
        if check:
            raise RuntimeError("timed out")
        return 124, "timed out"


def detach(cmd):
    subprocess.Popen(cmd, shell=isinstance(cmd, str), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     stdin=subprocess.DEVNULL, start_new_session=True)


def konsole(cmd, hold=True):
    detach(["konsole"] + (["--hold"] if hold else []) + ["-e", "bash", "-lc", cmd])


def kread(f, group, key, default=""):
    args = ["kreadconfig6", "--file", f]
    for g in group if isinstance(group, (list, tuple)) else [group]:
        args += ["--group", g]
    rc, out = sh(args + ["--key", key, "--default", default], timeout=5)
    return out if rc == 0 else default


def kwrite(f, group, key, value, notify=True):
    """Write a KDE config key (value None = delete it, back to Plasma's default). --notify tells running apps."""
    args = ["kwriteconfig6", "--file", f] + (["--notify"] if notify else [])
    for g in group if isinstance(group, (list, tuple)) else [group]:
        args += ["--group", g]
    if value is None:
        sh(args + ["--key", key, "--delete"], timeout=5, check=True)
    elif isinstance(value, bool):
        sh(args + ["--type", "bool", "--key", key, "true" if value else "false"], timeout=5, check=True)
    else:
        sh(args + ["--key", key, str(value)], timeout=5, check=True)


def readkv(path):
    d = {}
    try:
        for line in pathlib.Path(path).read_text().splitlines():
            k, _, v = line.partition("=")
            if k.strip():
                d[k.strip()] = v.strip()
    except OSError:
        pass
    return d


_bus = None


def bus():
    global _bus
    if _bus is None:
        import dbus
        _bus = dbus.SessionBus()
    return _bus


def dcall(service, path, iface, method, *args, default=None):
    try:
        import dbus
        return getattr(dbus.Interface(bus().get_object(service, path), iface), method)(*args)
    except Exception:
        return default


# ---- systemd user units (batched) ----
_units = {}


def load_units(names):
    names = [n for n in names if n not in _units]
    if not names:
        return
    _, act = sh(["systemctl", "--user", "is-active"] + names, timeout=10)
    _, ena = sh(["systemctl", "--user", "is-enabled"] + names, timeout=10)
    a, e = act.splitlines(), ena.splitlines()
    for i, n in enumerate(names):
        _units[n] = (a[i] if i < len(a) else "unknown", e[i] if i < len(e) else "unknown")


def unit_on(u):
    st = _units.get(u)
    return bool(st) and (st[0] in ("active", "activating") or (u.endswith(".service") and st[1] == "enabled"))


def unit_link(u):
    """Keep linked rice units installed (systemctl disable removes the link of a linked unit file)."""
    src = RICE / "systemd" / u
    dst = UNITDIR / u
    if src.exists() and not dst.exists():
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.symlink_to(src)
        sh(["systemctl", "--user", "daemon-reload"])


def units_set(units, on):
    for u in units:
        unit_link(u)
        if on:
            sh(["systemctl", "--user", "reset-failed", u])
            sh(["systemctl", "--user", "enable", "--now", u], check=True)
        else:
            sh(["systemctl", "--user", "disable", "--now", u])
            unit_link(u)
    _units.clear()


# ---- KWin effects and scripts ----
def kwin_enabled(plugin):
    return kread("kwinrc", "Plugins", plugin + "Enabled", "false") == "true"


def effect_loaded(e):
    return bool(dcall("org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "isEffectLoaded", e, default=False))


def script_loaded(s):
    return bool(dcall("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting", "isScriptLoaded", s, default=False))


def effect_set(e, on):
    kwrite("kwinrc", "Plugins", e + "Enabled", "true" if on else "false")
    dcall("org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "loadEffect" if on else "unloadEffect", e)


def script_set(s, on):
    kwrite("kwinrc", "Plugins", s + "Enabled", "true" if on else "false")
    if not on:
        dcall("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting", "unloadScript", s)
    dcall("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")
    if on:
        dcall("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting", "start")


