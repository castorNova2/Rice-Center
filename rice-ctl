# snapshot taken before leaving the rice brings ALL of it back
LOOK_PATHS = [".config/" + n for n in ("dolphinrc", "gtk-3.0", "gtk-4.0", "gtkrc", "gtkrc-2.0", "kcminputrc",
              "kdedefaults", "kdeglobals", "konsolerc", "kwinrc", "kwinrulesrc", "plasma-localerc",
