META, ALT, CTRL, SHIFT = 0x10000000, 0x08000000, 0x04000000, 0x02000000
SHORTCUTS = {   # id: (desktop file, friendly name, key code, label)
    "key-quickmenu": ("rice-powermenu.desktop", "Rice Quick Menu", META | ALT | 0x58, "Meta+Alt+X"),
    "key-cheatsheet": ("rice-cheatsheet.desktop", "Rice Cheat Sheet", META | 0x2F, "Meta+/"),
    "key-taskmanager": ("rice-taskmanager.desktop", "Rice Task Manager", CTRL | SHIFT | 0x01000000, "Ctrl+Shift+Esc"),
    "key-ricecenter": ("rice-center.desktop", "Rice Center", META | ALT | 0x52, "Meta+Alt+R"),
}


def shortcut_get(fid):
    f, name, _, _ = SHORTCUTS[fid]
    keys = dcall("org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "shortcut",
                 [f, "_launch", name, name], default=None)
    return bool(keys) and any(int(k) for k in keys)


def shortcut_set(fid, on):
    import dbus
    f, name, key, _ = SHORTCUTS[fid]
    aid = dbus.Array([f, "_launch", name, name], signature="s")
    dcall("org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "doRegister", aid)
    keys = dbus.Array([dbus.Int32(key)] if on else [], signature="i")
    dcall("org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "setShortcut", aid, keys, dbus.UInt32(0))


# ---- Plasma ----
def plasma_eval(js):
    return sh(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js], timeout=10)[1]


def restart_plasma():
    sh(["systemctl", "--user", "restart", "plasma-plasmashell.service"], timeout=60)


def run_bin(name, *args, timeout=60):
    return sh([str(BIN / name)] + list(args), timeout=timeout)


