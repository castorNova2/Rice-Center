def touch_get(fid):
    tps = touchpads()
    return bool(tps) and all(bool(p.Get("org.kde.KWin.InputDevice", TOUCH[fid][0])) for p in tps)


def touch_set(fid, on):
    import dbus
    prop, key = TOUCH[fid][:2]
    tps = touchpads()
    if not tps:
        raise RuntimeError("no touchpad found")
    for p in tps:
        g = lambda k: p.Get("org.kde.KWin.InputDevice", k)
        p.Set("org.kde.KWin.InputDevice", prop, dbus.Boolean(on))
        # persist the way System Settings does: kcminputrc [Libinput][vendor][product][name]
        kwrite("kcminputrc", ["Libinput", str(int(g("vendor"))), str(int(g("product"))), str(g("name"))], key, bool(on))


# ------------------------------------------------------------------------------------------- registry
def F(**kw):
    kw.setdefault("kind", "toggle")
    kw.setdefault("detail", "")
    kw.setdefault("settings", [])
    kw.setdefault("actions", [])
    kw.setdefault("help", "")
    return kw


def unit_feature(fid, page, title, desc, units, help_="", **kw):
    load_units(units)
    on = all(unit_on(u) for u in units)
    return F(id=fid, page=page, title=title, desc=desc, on=on, units=units, help=help_,
             detail=", ".join(f"{u}: {_units[u][0]}" for u in units) if not on else "", **kw)


