def current_look():
    try:
        return json.loads(LOOK_STATE.read_text()).get("look", "rice")
    except (OSError, ValueError):
        return "rice"


def look_switch(target, layout=False):
    cur = current_look()
    if target == cur:
        return f"already on the {target} look"
    log = []
    if target == "rice":
        st = json.loads(LOOK_STATE.read_text())
        snap = RICE / "backups" / st["snapshot"]
        # the snapshot also holds ~/.config/kde-rice (to-do list, mood, settings): keep today's copy of that
        keep = pathlib.Path(sh(["mktemp", "-d"])[1])
        sh(["cp", "-a", str(KR) + "/.", str(keep)])
        sh(["systemctl", "--user", "stop", "plasma-plasmashell.service"], timeout=30)
        rc, out = sh(["bash", str(snap / "restore-this-state.sh")], timeout=120)
        log.append(out)
        sh(["cp", "-a", str(keep) + "/.", str(KR)])
        sh(["rm", "-rf", str(keep)])
        sh(["systemctl", "--user", "daemon-reload"])
        units_set(st.get("units", []), True)
        for s in st.get("scripts", []):
            script_set(s, True)
        for e in st.get("effects", []):
            effect_set(e, True)
        sh(["plasma-apply-colorscheme", "MidnightBlue"]); sh(["plasma-apply-desktoptheme", "rice"])
        sh(["plasma-apply-cursortheme", "Bibata-Modern-Ice"]); sh(["/usr/libexec/plasma-changeicons", "Papirus-Dark"])
        run_bin("rice-gtk")
        sh(["systemctl", "--user", "start", "plasma-plasmashell.service"], timeout=30)
        dcall("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")
        LOOK_STATE.unlink(missing_ok=True)
        return "back to the rice (snapshot " + st["snapshot"] + " restored, services back on)"

    if cur != "rice":                     # stock <-> original: go back to the rice first, then switch
        log.append(look_switch("rice"))
    # leaving the rice: snapshot + remember what to turn back on
    rc, out = run_bin("rice-backup", "look-rice", *LOOK_PATHS, timeout=180)
    m = re.search(r"backups/(\d+-pre-look-rice)", out)
    if not m:
        raise RuntimeError("snapshot failed, nothing changed:\n" + out)
    load_units(LOOK_UNITS)
    st = {"look": target, "snapshot": m.group(1), "made": time.strftime("%Y-%m-%d %H:%M"),
          "units": [u for u in LOOK_UNITS if unit_on(u)], "scripts": [], "effects": []}
    KR.mkdir(parents=True, exist_ok=True)
    LOOK_STATE.write_text(json.dumps(st, indent=1))
    units_set(st["units"], False)
    run_bin("rice-gtk", "off")
    if target == "stock":
        for e in ("rice-tide", "kwin4_effect_shapecorners"):
            if kwin_enabled(e):
                st["effects"].append(e)
                effect_set(e, False)
        LOOK_STATE.write_text(json.dumps(st, indent=1))
        args = ["plasma-apply-lookandfeel", "--apply", "org.kde.breezedark.desktop"] + (["--resetLayout"] if layout else [])
        log.append(sh(args, timeout=60)[1])
        kwrite("ksplashrc", "KSplash", "Theme", "org.kde.breeze.desktop")
        sh(["plasma-apply-cursortheme", "breeze_cursors"])
        dcall("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")
        return "stock KDE look applied (Breeze Dark). Back with: Back to the rice"
    # original: the 2026-11-09 configs from backups/1-original, without deleting any rice files
    orig = RICE / "backups/1-original/config"
    sh(["systemctl", "--user", "stop", "plasma-plasmashell.service"], timeout=30)
    for f in orig.iterdir():
        dst = CFG / f.name
        if f.is_dir():
            sh(["cp", "-a", str(f) + "/.", str(dst)])
        else:
            sh(["cp", "-a", str(f), str(dst)])
    kwrite("ksplashrc", "KSplash", "Theme", "org.kde.breeze.desktop")
    sh(["plasma-apply-colorscheme", "BreezeDark"]); sh(["/usr/libexec/plasma-changeicons", "breeze-dark"])
    sh(["plasma-apply-cursortheme", "breeze_cursors"])
    sh(["systemctl", "--user", "start", "plasma-plasmashell.service"], timeout=30)
    time.sleep(2)
    sh(["plasma-apply-desktoptheme", "default"])
    dcall("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")
    return "original look (before the ricing) applied. Rice files are kept; back with: Back to the rice"


